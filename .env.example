# Ambiente
NODE_ENV=development

# API
API_PORT=3000
# API_BASE_URL é derivada automaticamente como http://localhost:${API_PORT}.
# Defina apenas se precisar de uma URL diferente (ex: Codespaces, produção).
# API_BASE_URL=https://meu-dominio.com

# Frontend
WEB_PORT=5173
# WEB_BASE_URL segue a mesma lógica de API_BASE_URL.
# WEB_BASE_URL=https://meu-dominio.com

# Modo de autenticação:
#   dev      -> login local de desenvolvimento (usuários DEV_ADMIN_*/DEV_USER_*), sem Keycloak. Proibido em produção.
#   keycloak -> Keycloak real (Docker ou externo, via KEYCLOAK_BASE_URL)
AUTH_MODE=dev

# Docker é opcional e só serve para subir o Keycloak (o banco é um arquivo SQLite, sem servidor).
# false = sem Docker. true = sobe o Keycloak com `docker compose` (use com AUTH_MODE=keycloak).
USE_DOCKER=false

# Prisma / banco SQLite da aplicação.
# Caminhos relativos são resolvidos a partir de apps/api/prisma/ (aqui: apps/api/prisma/dev.db).
DATABASE_URL=file:./dev.db

# Keycloak
KEYCLOAK_PORT=8080
# KEYCLOAK_BASE_URL segue a mesma lógica de API_BASE_URL.
# KEYCLOAK_BASE_URL=https://id.meu-dominio.com
KEYCLOAK_REALM=clinica
KEYCLOAK_CLIENT_ID=clinica-server
KEYCLOAK_CLIENT_SECRET=clinica_dev_client_secret
KEYCLOAK_ADMIN_CLIENT_ID=clinica-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=clinica_dev_admin_client_secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PASSWORD_MIN_LENGTH=12

# Sessão
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=clinica_session
OIDC_CORRELATION_TTL_SECONDS=300
SESSION_CLEANUP_INTERVAL_MINUTES=60

# Usuários de desenvolvimento
DEV_ADMIN_EMAIL=admin@clinica.local
DEV_ADMIN_PASSWORD=ChangeMe123456!
DEV_ADMIN_NAME=Administrador
DEV_USER_EMAIL=user@clinica.local
DEV_USER_PASSWORD=ChangeMe123456!
DEV_USER_NAME=Usuário
